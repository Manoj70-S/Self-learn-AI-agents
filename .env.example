# Mem0 Cloud Platform API Key (Optional)
MEM0_API_KEY=your_mem0_api_key_here

# OpenAI API Key (Optional: system runs in zero-dependency offline mode if omitted)
OPENAI_API_KEY=your_openai_api_key_here

# LLM & Embedding Models
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Storage Engine ("sqlite" or "qdrant")
COGNIMEM_STORAGE_PROVIDER=sqlite
COGNIMEM_DB_PATH=cognimem.db

# Qdrant Configuration (Only needed if COGNIMEM_STORAGE_PROVIDER=qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=agent_memories
# QDRANT_URL=https://your-cluster-url.qdrant.io
# QDRANT_API_KEY=your_qdrant_cloud_api_key
